<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.taopiaopiao.mapper.ReviewLikeMapper">
    
    <!-- 插入点赞记录 -->
    <insert id="insert" parameterType="ReviewLike" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO review_like (user_id, review_id)
        VALUES (#{userId}, #{reviewId})
    </insert>
    
    <!-- 删除点赞记录 -->
    <delete id="delete">
        DELETE FROM review_like 
        WHERE user_id = #{userId} AND review_id = #{reviewId}
    </delete>
    
    <!-- 统计评论点赞数 -->
    <select id="countByReviewId" resultType="Integer">
        SELECT COUNT(*) FROM review_like WHERE review_id = #{reviewId}
    </select>
    
    <!-- 检查用户是否已点赞 -->
    <select id="findByUserAndReview" resultType="ReviewLike">
        SELECT * FROM review_like 
        WHERE user_id = #{userId} AND review_id = #{reviewId}
        LIMIT 1
    </select>
    
</mapper>
