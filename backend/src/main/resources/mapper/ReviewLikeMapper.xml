<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.taopiaopiao.mapper.ReviewLikeMapper">

    <!-- 点赞（INSERT IGNORE利用唯一索引uk_user_review保证幂等性） -->
    <insert id="insertIgnore" parameterType="ReviewLike" useGeneratedKeys="true" keyProperty="id">
        INSERT IGNORE INTO review_like (user_id, review_id)
        VALUES (#{userId}, #{reviewId})
    </insert>

    <!-- 取消点赞 -->
    <delete id="deleteByUserAndReview">
        DELETE FROM review_like
        WHERE user_id = #{userId} AND review_id = #{reviewId}
    </delete>

    <!-- 查询用户对某评论的点赞记录 -->
    <select id="findByUserAndReview" resultType="ReviewLike">
        SELECT * FROM review_like
        WHERE user_id = #{userId} AND review_id = #{reviewId}
    </select>

    <!-- 查询某评论的点赞数 -->
    <select id="countByReviewId" resultType="Integer">
        SELECT COUNT(*) FROM review_like WHERE review_id = #{reviewId}
    </select>

    <!-- 批量查询用户对多条评论的点赞记录 -->
    <select id="findByUserIdAndReviewIds" resultType="ReviewLike">
        SELECT * FROM review_like
        WHERE user_id = #{userId}
        <if test="reviewIds != null and reviewIds.size() > 0">
            AND review_id IN
            <foreach collection="reviewIds" item="reviewId" open="(" separator="," close=")">
                #{reviewId}
            </foreach>
        </if>
    </select>

    <!-- 删除某评论的所有点赞记录 -->
    <delete id="deleteByReviewId">
        DELETE FROM review_like WHERE review_id = #{reviewId}
    </delete>

</mapper>
