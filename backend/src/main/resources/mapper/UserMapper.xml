<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.taopiaopiao.mapper.UserMapper">
    
    <!-- 根据用户名查询用户 -->
    <select id="findByUsername" resultType="User">
        SELECT * FROM user WHERE username = #{username}
    </select>
    
    <!-- 根据ID查询用户 -->
    <select id="findById" resultType="User">
        SELECT * FROM user WHERE id = #{id}
    </select>
    
    <!-- 插入用户 -->
    <insert id="insert" parameterType="User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password, nickname, avatar, email)
        VALUES (#{username}, #{password}, #{nickname}, #{avatar}, #{email})
    </insert>
    
    <!-- 更新用户信息 -->
    <update id="update" parameterType="User">
        UPDATE user SET nickname = #{nickname}, avatar = #{avatar}, email = #{email}
        WHERE id = #{id}
    </update>
    
</mapper>
